// تایپ کد کامل یک والد -> مسیر درخت خودکار باز می‌شه، انتخاب برگ -> مقدار ست می‌شه
const AccountCodeField = ({ value, onChange, onSelect, onMismatch, allowAnyLevel = false, label = "کد حساب", size = "small", disabled, sx }) => {
    const [localValue, setLocalValue] = useState(value || "");
    const picker = useEntityPicker("Account");

