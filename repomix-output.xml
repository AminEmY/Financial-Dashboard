            <MenuItem value={1}>تامین‌کننده</MenuItem>
          </TextField>
        </AccordionDetails>
      </Accordion>

      <Box sx={{ mt: 3, display: "flex", justifyContent: "flex-end" }}>
        <Button variant="contained" onClick={handleSave} disabled={saving}>
          {saving ? "در حال ذخیره..." : "ذخیره حساب"}
