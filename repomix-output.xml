          <MenuItem value={2}>تفصیلی</MenuItem>
        </TextField>

        <TextField
          select
          {...fieldProps("ماهیت حساب :")}
          sx={{ width: 170 }}
          value={account.accountNature}
          disabled={fieldLocks.accountNature}
