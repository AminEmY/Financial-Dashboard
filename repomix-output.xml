const LEGAL_FIELDS = [
  ["shomareSabt", "شماره ثبت"], ["codeEghtesadi", "کد اقتصادی"], ["nationalCode", "کد ملی"],
  ["faaliat", "نوع فعالیت"], ["birthDate", "تاریخ تولد"],
